# Database
DATABASE_URL="postgresql://usuario:senha@localhost:5432/olhosdegato?schema=public"

# JWT
JWT_SECRET="gere-uma-chave-secreta-forte-aqui"
JWT_EXPIRES_IN="7d"

# Server
PORT=3333
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Proxy confiável para rate-limit por IP (evita spoofing de X-Forwarded-For).
# Número de hops de proxy (1 = borda do Railway) ou um CIDR/IP. Default: 1.
# TRUST_PROXY="1"

# Mail (Mailtrap HTTP API — porta 443, funciona em Railway/PaaS que bloqueiam SMTP egress)
# MAILTRAP_API_TOKEN: criar em mailtrap.io > Settings > API Tokens
# MAILTRAP_INBOX_ID:  numero na URL da inbox sandbox (mailtrap.io/inboxes/<ID>/messages); obrigatorio quando MAILTRAP_MODE=sandbox (default)
# MAILTRAP_MODE:      "sandbox" (default, manda pra inbox virtual) ou "live" (envio real, requer dominio verificado)
MAILTRAP_API_TOKEN=""
MAILTRAP_INBOX_ID=""
# MAILTRAP_MODE="sandbox"
MAIL_FROM="Olhos de Gato <noreply@olhosdegato.com.br>"

# CORS (lista separada por vírgula — sem espaços)
CORS_ORIGIN="http://localhost:3000"

# Storage (S3/Cloudflare R2) — usar "local" para desenvolvimento
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# AbacatePay (pagamento) — OBRIGATÓRIO em produção
# Dashboard: https://www.abacatepay.com (Integrar > API Keys; key de DEV = simulado, key de prod = real)
# Webhook: Integrar > Webhooks apontando pra /api/v1/public/webhooks/abacatepay?webhookSecret=<o-secret-abaixo>
ABACATEPAY_API_KEY=""
ABACATEPAY_WEBHOOK_SECRET=""

# Mercado Livre (criar app em https://developers.mercadolivre.com.br)
ML_APP_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3333/api/v1/admin/marketplace/accounts/MERCADO_LIVRE/callback"

# MelhorEnvio (frete) — obter token em https://melhorenvio.com.br
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_SANDBOX="true"
