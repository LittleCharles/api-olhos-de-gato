# Database
DATABASE_URL="postgresql://usuario:senha@localhost:5432/olhosdegato?schema=public"

# JWT
JWT_SECRET="gere-uma-chave-secreta-forte-aqui"
JWT_EXPIRES_IN="7d"

# Server
PORT=3333
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Mail (SMTP — Mailtrap Sandbox em dev, Sending/Live ou SES/SendGrid em prod)
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Olhos de Gato <noreply@olhosdegato.com.br>"

# CORS (lista separada por vírgula — sem espaços)
CORS_ORIGIN="http://localhost:3000"

# Storage (S3/Cloudflare R2) — usar "local" para desenvolvimento
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Stripe (pagamento) — OBRIGATÓRIO em produção
# Dashboard: https://dashboard.stripe.com/apikeys
# Webhook secret: criar endpoint em https://dashboard.stripe.com/webhooks apontando pra /api/v1/public/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Mercado Livre (criar app em https://developers.mercadolivre.com.br)
ML_APP_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3333/api/v1/admin/marketplace/accounts/MERCADO_LIVRE/callback"

# MelhorEnvio (frete) — obter token em https://melhorenvio.com.br
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_SANDBOX="true"
